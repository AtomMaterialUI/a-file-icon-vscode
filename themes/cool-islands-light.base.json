  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c8c8c"
      }
    },
    {
      "name": "Block comment",
      "scope": [
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c8c8c"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c8c8c"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "comment.block.documentation storage.type",
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "constant.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#0033b3"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#080808"
      }
    },
    {
      "name": "Word operator",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.instanceof",
        "keyword.operator.typeof"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#0033b3"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#067d17"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder",
        "meta.format.percent",
        "constant.other.placeholder"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#0037a6"
      }
    },
    {
      "name": "Invalid string escape",
      "scope": [
        "invalid.illegal.character.escape",
        "invalid.illegal.unrecognized-string-escape"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#067d17"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#1750eb"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "variable.other.constant",
        "constant.other",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#871094"
      }
    },
    {
      "name": "Function declaration",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#00627a"
      }
    },
    {
      "name": "Function call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#080808"
      }
    },
    {
      "name": "Method call",
      "scope": [
        "meta.method-call entity.name.function",
        "meta.function-call.method"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#080808"
      }
    },
    {
      "name": "Field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#871094"
      }
    },
    {
      "name": "Class name",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#000000"
      }
    },
    {
      "name": "Class reference",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type.module"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#000000"
      }
    },
    {
      "name": "Interface name",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#000000"
      }
    },
    {
      "name": "Type parameter",
      "scope": [
        "entity.name.type.parameter",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#007e8a"
      }
    },
