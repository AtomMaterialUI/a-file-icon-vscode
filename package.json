{
  "name": "cool-icon-vscode",
  "displayName": "Cool Theme Kit",
  "description": "JetBrains (PyCharm New UI) style theme for VS Code: file icons, colors and product icons, with other installed themes layered on top by priority",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WoogaJJangka/a-file-icon-vscode.git"
  },
  "author": {
    "name": "siwon Jeon",
    "url": "https://github.com/WoogaJJangka"
  },
  "license": "MIT",
  "main": "./dist/extension",
  "icon": "logo.png",
  "homepage": "https://github.com/WoogaJJangka/a-file-icon-vscode/blob/main/README.md",
  "scripts": {
    "build": "bun run compile:dev && bun run postcompile",
    "changelog": "changelog-machine --config changelog.config.json",
    "oslllo-svg-fixer": "node node_modules/oslllo-svg-fixer/src/cli.js",
    "sync:upstream": "ts-node ./src/scripts/icons/syncUpstream.ts",
    "check": "ts-node ./src/scripts/icons/checks/runChecks.ts",
    "compile": "node esbuild.js --production",
    "compile-web": "webpack --config ./build/web-extension.webpack.config.js",
    "compile:dev": "webpack --config ./build/webpack.config.js --mode none",
    "compile:watch": "webpack --config ./build/webpack.config.js --mode none --watch",
    "generateJson": "ts-node ./src/scripts/icons/generateJson.ts",
    "lint": "eslint \"./src/**/*.ts\"",
    "package-web": "webpack --mode production --devtool hidden-source-map --config ./build/web-extension.webpack.config.js",
    "postcompile": "bun run generateJson && bun run check",
    "pretest": "bun run build && tsc -p ./",
    "test:smoke": "node ./test/smoke/run.js",
    "test:unit": "node ./test/run-unit.js",
    "test:coverage": "c8 node ./test/run-unit.js",
    "audit:shipped": "bun ./test/checks/auditShipped.js",
    "check:size": "node ./test/checks/sizeBudget.js",
    "webfont": "ts-node ./src/scripts/icons/webfont.ts",
    "version": "bun run changelog && git add CHANGELOG.md",
    "vsce": "vsce package --yarn",
    "vscode:prepublish": "bun run lint && bun run compile && bun run package-web",
    "watch-web": "webpack --watch --config ./build/web-extension.webpack.config.js",
    "sync:colors": "ts-node ./src/scripts/themes/syncJetbrainsColors.ts",
    "build:product-icons": "ts-node ./src/scripts/productIcons/buildJetbrainsFont.ts"
  },
  "dependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fs-extra": "^11.2.0",
    "globals": "^15.12.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lodash.merge": "4.6.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/vscode": "~1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vscode/test-electron": "^2.4.1",
    "c8": "^10.1.3",
    "changelog-machine": "^1.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.1",
    "eslint-plugin-jsonc": "^2.18.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "fast-xml-parser": "4.5.3",
    "glob": "^11.0.0",
    "i18next": "^24.0.2",
    "mocha": "^11.0.0",
    "oslllo-potrace": "3.0.0",
    "oslllo-svg-fixer": "^5.0.0",
    "prettier": "^3.4.1",
    "puppeteer": "^23.9.0",
    "rimraf": "^6.0.1",
    "svgo": "^3.3.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "webfont": "^11.2.26",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "badges": [],
  "browser": "./dist/web/extension.js",
  "bugs": {
    "url": "https://github.com/WoogaJJangka/a-file-icon-vscode/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "icons": {
      "atom-angular": {
        "default": {
          "fontCharacter": "\\ea2a",
          "fontPath": "./productIcons/a-file-icon-vscode.woff"
